{
  "name": "revolution-app",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.16.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:network": "vite --host",
    "dev:port": "vite --port",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "test": "vitest",
    "test:unit": "vitest --run",
    "test:coverage": "vitest --coverage",
    "test:production": "vitest --run --config vitest.config.production.ts",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load-test.js",
    "test:security": "npm audit && snyk test",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:security",
    "validate:production": "tsx scripts/production-validation.ts",
    "preflight": "bash scripts/pre-flight-check.sh",
    "validate:db": "tsx scripts/validate-database-queries.ts",
    "validate:db:watch": "tsx scripts/validate-database-queries.ts --watch",
    "validate:prod": "tsx scripts/validate-production-db.ts",
    "db:schema": "tsx scripts/validate-production-db.ts",
    "validate:live": "tsx scripts/validate-live-queries.ts",
    "validate:full": "npm run validate:prod && npm run validate:live",
    "investigate:db": "tsx scripts/investigate-database.ts",
    "eradicate:nulls": "tsx scripts/eradicate-nulls.ts",
    "eradicate:nulls:enhanced": "tsx scripts/enhanced-eradicate-nulls.ts",
    "eradicate:nulls:final": "tsx scripts/final-eradicate-nulls.ts",
    "check:nulls": "grep -r '\\bnull\\b' src/ --include='*.ts' --include='*.tsx' | wc -l",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.91.0",
    "@daily-co/daily-react": "^0.25.2",
    "@fluentui/react-components": "^9.74.1",
    "@fluentui/react-icons": "^2.0.330",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@supabase/supabase-js": "^2.108.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.10",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "immer": "^11.1.8",
    "jotai": "^2.18.0",
    "livekit-client": "^2.19.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "web-vitals": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
